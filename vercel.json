{
  "rewrites": [
    {
      "source": "/retreat",
      "destination": "/retreat.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/preview",
      "destination": "/preview.html"
    }
  ],
  "headers": [
    {
      "source": "/retreat",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/retreat.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
